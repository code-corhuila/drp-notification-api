HTTP_ADDR=:8085
SERVICE_NAME=notification-service
IDENTITY_JWKS_URL=http://localhost:8081/api/v1/auth/jwks
# Shared with payment and reservation. Not a user JWT. Gateway does not route /internal/*.
INTERNAL_EVENT_TOKEN=spacehub-dev-internal
# Empty = in-memory empty catalogs (tests / walking without the other APIs).
PAYMENT_API_URL=http://localhost:8084
RESERVATION_API_URL=http://localhost:8083
SPACE_API_URL=http://localhost:8082
# Empty = memory inbox. Set after drp-infra-mongo + drp-notification-db migrate.
MONGO_URL=mongodb://notification_app:change-me-notification@localhost:27017/notification?authSource=notification
